# SOL_Tea — environment template.
# Copy to .env and fill in locally. NEVER commit .env (it is git-ignored).
# This file contains NO real credentials: every value below is a placeholder.

# ---------------------------------------------------------------- chain access
# Primary RPC provider (HTTPS). A dedicated/paid provider is required for
# production: the public endpoint is rate limited and is not an acceptable
# Phase-1 supplier (see docs/SOURCE_REGISTER.md).
RPC_HTTP_URL="https://api.mainnet-beta.solana.com"
RPC_WS_URL="wss://api.mainnet-beta.solana.com"

# Independent secondary provider. A second URL on the same backend is NOT
# redundancy; it must be a genuinely independent failure domain.
RPC_HTTP_URL_SECONDARY=""
RPC_WS_URL_SECONDARY=""

# ---------------------------------------------------------------- signer
# Absolute path to a Solana CLI JSON keypair OUTSIDE this repository, e.g.
# /etc/sol-tea/keys/operator.json  (chmod 600, owned by the service user).
# The file must never be copied into the working tree.
WALLET_KEYPAIR_PATH=""

# Public address of the signer above (safe to record; used for preflight
# assertions so a wrong key file is rejected before any signing).
OPERATOR_PUBLIC_ADDRESS=""

# ---------------------------------------------------------------- config files
SOL_TEA_CHAIN_CONFIG="config/mainnet.solana.yaml"
SOL_TEA_POLICY_CONFIG="config/policy.solana.yaml"

# ---------------------------------------------------------------- signer service
# Bearer token the signer HTTP role requires. Minimum 16 characters; the service
# refuses to start with a shorter one. Generate with: openssl rand -hex 32
SIGNER_SERVICE_TOKEN=""

# Deployment secret from which the signer derives its payload-store encryption
# key. Minimum 16 characters. Changing it makes previously stored payloads
# unreadable, which is intentional: the key must match the deployment that
# wrote them.
SIGNER_STORE_KEY=""

# ---------------------------------------------------------------- runtime
SERVICE_NAME="sol-tea"           # service label in every structured log line
LOG_LEVEL="info"                 # debug | info | warn | error
LOG_PRETTY="false"               # true for human-readable local logs
HEALTH_PORT="8787"
JOURNAL_DIR="var/journal"        # append-only signed outbox + reconciliation evidence
STORE_PATH="var/state/sol-tea.db"  # durable SQLite state of record (WAL)
RPC_TIMEOUT_MS="15000"           # per-call deadline; bounds a hung provider

# Master switch. Live signing stays disabled until the V6 PRE-LIVE gate is
# satisfied and the owner sets this together with chains.solana.enabled.
ENABLE_LIVE_EXECUTION="false"

# Emergency stop. Any non-empty value other than "false" pauses NEW signing;
# already-signed transactions are still reconciled.
EMERGENCY_PAUSE="false"

# Optional https webhook for operator alerts (critical failures, remote pause).
# Empty disables remote alerting; the independent pause FILE still works.
ALERT_WEBHOOK_URL=""
